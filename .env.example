# OPTIONAL local development only. Never upload .env. Hosted Apps use app.yaml.
ATLAS_AUTH_MODE=local
ATLAS_HISTORY_BACKEND=lakebase
DATABRICKS_HOST=https://REPLACE_WITH_TARGET_WORKSPACE_HOST
DATABRICKS_CONFIG_PROFILE=target-workspace
DATABRICKS_GENIE_AGENT_ID=REPLACE_WITH_TARGET_GENIE_AGENT_ID
DATABRICKS_CONTRACT_INDEX=REPLACE_WITH_TARGET_CATALOG_SCHEMA_INDEX
DATABRICKS_MODEL_API=gateway
DATABRICKS_AGENT_MODEL=system.ai.meta-llama-3-3-70b-instruct
DATABRICKS_EMBEDDING_MODEL=system.ai.gte-large-en
ATLAS_RAG_TOP_K=20
# Optional: fetch shared glossary files at startup (local mode uses the CLI profile).
# ATLAS_GLOSSARY_WORKSPACE_DIR=/Workspace/Shared/business_glossary
# Alternative: package the team's glossary folder. Set only ONE glossary option.
# ATLAS_GLOSSARY_DIR=app_assets/business_glossary
# Optional: ATLAS_RAG_HISTORY_MESSAGES=6 (individual messages)
# To use existing serving endpoints instead of AI Gateway, set:
# DATABRICKS_MODEL_API=serving
# DATABRICKS_EMBEDDING_ENDPOINT=<your-embedding-endpoint>
# DATABRICKS_ANSWER_ENDPOINT=<your-chat-endpoint>
LAKEBASE_ENDPOINT=projects/REPLACE_WITH_PROJECT/branches/REPLACE_WITH_BRANCH/endpoints/REPLACE_WITH_ENDPOINT
PGHOST=REPLACE_WITH_TARGET_LAKEBASE_HOST
PGDATABASE=databricks_postgres
PGUSER=REPLACE_WITH_YOUR_TARGET_DATABASE_OAUTH_ROLE
PGPORT=5432
PGSSLROOTCERT=certifi
# For local development without Lakebase: ATLAS_HISTORY_BACKEND=sqlite
# For a UI-only local preview: VITE_APP_MODE=preview
