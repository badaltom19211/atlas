# OPTIONAL local development only. Never upload .env. Hosted Apps use app.yaml.
ATLAS_AUTH_MODE=local
ATLAS_HISTORY_BACKEND=lakebase
DATABRICKS_HOST=https://REPLACE_WITH_TARGET_WORKSPACE_HOST
DATABRICKS_CONFIG_PROFILE=target-workspace
DATABRICKS_CONTRACT_INDEX=REPLACE_WITH_TARGET_CATALOG_SCHEMA_INDEX
DATABRICKS_EMBEDDING_ENDPOINT=REPLACE_WITH_TARGET_EMBEDDING_SERVING_ENDPOINT
DATABRICKS_ANSWER_ENDPOINT=REPLACE_WITH_TARGET_CHAT_SERVING_ENDPOINT
# Optional: ATLAS_RAG_TOP_K=5 and ATLAS_RAG_HISTORY_MESSAGES=6 (individual messages)
LAKEBASE_ENDPOINT=projects/REPLACE_WITH_PROJECT/branches/REPLACE_WITH_BRANCH/endpoints/REPLACE_WITH_ENDPOINT
PGHOST=REPLACE_WITH_TARGET_LAKEBASE_HOST
PGDATABASE=databricks_postgres
PGUSER=REPLACE_WITH_YOUR_TARGET_DATABASE_OAUTH_ROLE
PGPORT=5432
PGSSLROOTCERT=certifi
# For local development without Lakebase: ATLAS_HISTORY_BACKEND=sqlite
# For a UI-only local preview: VITE_APP_MODE=preview
